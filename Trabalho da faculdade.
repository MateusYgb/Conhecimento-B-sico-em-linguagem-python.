def qtd_toras():
    global quantidade_toras
    global desconto
    while(True):
        try:
            quantidade_toras = int(input("Quantos m3 de tora você deseja? "))
            if (quantidade_toras > 2000):
                print(f"Não aceitamos essa quantidade de tora: {quantidade_toras}")
            elif (quantidade_toras >= 1000 and quantidade_toras <= 2000):
                desconto = (quantidade_toras * tipo_madeira) * (16/100)
                break
            elif (quantidade_toras >= 500 and quantidade_toras < 1000):
                desconto = (quantidade_toras * tipo_madeira) * (9/100)
                break
            elif (quantidade_toras >= 100 and quantidade_toras < 500):
                desconto = (quantidade_toras * tipo_madeira) * (4/100)
                break
            else:
                print("Não há desconto")
                break
        except ValueError:
            print("Ops, digite um valor númerico...")


    return print(f"Quantidade de toras: {quantidade_toras}. Desconto de: {desconto}")


def tipo_transporte():
    print("1 - Transporte Rodoviário - R$ 1000.00")
    print("2 - Transporte Ferroviário - R$ 2000.00")
    print("3 - Transporte Hidroviário - R$ 2500.00")

    global valor_transporte
    while(True):
        tipo_transporte = int(input("Insira o tipo de transporte: "))
        if(tipo_transporte == 1):
            valor_transporte = 1000.00
            break
        elif(tipo_transporte == 2):
            valor_transporte = 2000.00
            break
        elif(tipo_transporte == 3):
            valor_transporte = 2500.00
            break
        else:
            print("Insira um valor válido")

    return print(f"O valor do transporte é: {valor_transporte}")



